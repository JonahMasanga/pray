# Environment Variables
# Copy this file to .env and fill in the values for your project.
# IMPORTANT: Never commit your actual .env file — it is listed in .gitignore.
# See README.md for setup instructions.

# ── Firebase ──────────────────────────────────────────────────────────────────
# Obtain these values from the Firebase Console → Project Settings → General
# → Your apps → Web app → Config object.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required by the AI Prayer Assistant (AIChat component).
# 1. Sign in at https://platform.openai.com/
# 2. Go to API Keys → Create new secret key.
# 3. Paste the generated key below (starts with "sk-").
# Note: Keep this key private. Do NOT commit it to source control.
VITE_OPENAI_API_KEY=your_openai_api_key_here
